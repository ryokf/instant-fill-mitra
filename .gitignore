# ==============================================================================
# Git Ignore for Instant Fill Mitra (Browser Extension + Rust Backend)
# ==============================================================================

# --- Rust & Cargo ---
# Build artifacts & target directories
/target/
**/target/
# Cargo backup files & debug files
**/*.rs.bk
*.pdb
# Compiled binaries & dynamic libraries
*.exe
*.dll
*.so
*.dylib
*.rlib
*.rmeta
# Profiling outputs
*.profdata
*.profraw

# --- Environment Variables & Sensitive Credentials ---
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
secrets/

# --- Node.js & Web / Extension Artifacts ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
# Extension packages & build distributions
dist/
build/
out/
*.zip
*.crx
*.xpi
# Bundler & linter caches
.cache/
.parcel-cache/
.turbo/
.eslintcache/

# --- Logs & Temporary Files ---
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
tmp/
temp/
scratch/

# --- IDE & Editors ---
# Visual Studio Code
.vscode/
*.code-workspace
# JetBrains (IntelliJ, RustRover, WebStorm, etc.)
.idea/
*.iml
*.iws
# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
# Sublime Text
*.sublime-project
*.sublime-workspace

# --- Operating System Files ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
# Linux
.directory
.Trash-*

# --- Testing & Coverage ---
coverage/
.nyc_output/
