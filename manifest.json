{
  "manifest_version": 3,
  "name": "AutoFill PPAT Mitra Kerja",
  "version": "1.3",
  "description": "Ekstensi panel melayang untuk mengisi otomatis data Penjual, Pembeli, PBB, dan BPHTB di web PPAT.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://ppat.atrbpn.go.id/*",
    "http://127.0.0.1:3001/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3002/*",
    "http://localhost:3002/*",
    "http://127.0.0.1:3003/*",
    "http://localhost:3003/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://ppat.atrbpn.go.id/*"],
      "css": ["src/ui/panel.css"],
      "js": [
        "src/core/namespace.js",
        "src/core/config.js",
        "src/data/pt-database.js",
        "src/data/saksi-database.js",
        "src/dom/dom-helpers.js",
        "src/services/pt-matcher.js",
        "src/services/page-reader.js",
        "src/fillers/penjual-filler.js",
        "src/fillers/persetujuan-filler.js",
        "src/fillers/saksi-filler.js",
        "src/fillers/akta-filler.js",
        "src/fillers/pembeli-filler.js",
        "src/fillers/sertipikat-filler.js",
        "src/fillers/pbb-bphtb-filler.js",
        "src/ui/panel-template.js",
        "src/ui/person-list.js",
        "src/ui/panel.js",
        "src/content/main.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Buka / Tutup Panel AutoFill PPAT"
  }
}
